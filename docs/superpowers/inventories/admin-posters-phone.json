{
  "feature": "Admin · Posters on the phone (P47-15 PR2)",
  "note": "Board: design_handoff_admin_redesign/boards/07-people-flags-operations/posters-mobile. CONTACT_SHEET_ROLE=admin. Read-only: nothing is printed or saved. Desktop is included to show it unchanged. This branch is cut from main before the route move (#523), so it walks the current Posters URL.",
  "widths": [
    { "label": "phone-320", "width": 320, "height": 740, "touch": true },
    { "label": "phone", "width": 390, "height": 844, "touch": true },
    { "label": "desktop", "width": 1300, "height": 900 }
  ],
  "rows": [
    {
      "id": "posters",
      "label": "Posters, a code picked",
      "steps": [
        {
          "goto": "/admin/invite-codes/posters",
          "wait": "[data-testid='posters-tab']",
          "settle": 2500
        }
      ]
    },
    {
      "id": "posters-change",
      "label": "Posters, Change opens the code list",
      "widths": ["phone-320", "phone"],
      "steps": [
        {
          "goto": "/admin/invite-codes/posters",
          "wait": "[data-testid='posters-tab']",
          "settle": 2500
        },
        { "clickRole": "button", "name": "^Change" },
        { "wait": "[role='radiogroup']", "settle": 800 }
      ]
    },
    {
      "id": "posters-bottom",
      "label": "Posters, scrolled to the checklist and Print bar",
      "widths": ["phone-320", "phone"],
      "steps": [
        {
          "goto": "/admin/invite-codes/posters",
          "wait": "[data-testid='posters-tab']",
          "settle": 2500
        },
        { "scroll": "bottom", "settle": 800 }
      ]
    }
  ]
}
