    {
      "id": "venue-capacity",
      "label": "Venues index, the Capacity sheet",
      "steps": [
        {
          "goto": "/venues",
          "wait": "button:has-text(\"Any capacity\"):visible",
          "settle": 4000
        },
        {
          "scrollTo": "button:has-text(\"Any capacity\"):visible",
          "settle": 600
        },
        {
          "click": "button:has-text(\"Any capacity\"):visible"
