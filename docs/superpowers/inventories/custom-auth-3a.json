{
  "feature": "Custom sign-in PR 3a · start and password screens (/sign-in/new)",
  "note": "Boards: design/design_handoff_custom_auth/boards/01-sign-in (start-m, start-320, start-d, start-light-m, start-light-d, start-email-error-m, password-m, password-d). Signed out, no sign-in. Not photographable here, so walked by hand: a real wrong password against an unknown email (text and timing), the breached state, the 429 and Client Trust (PR 3b), and the signed-in redirect (unit-tested). The Google button and the invite-code 'Applied' chip are later PRs.",
  "signedOut": true,
  "widths": [
    { "label": "phone-320", "width": 320, "height": 740, "touch": true },
    { "label": "phone", "width": 390, "height": 844, "touch": true },
    { "label": "desktop", "width": 1300, "height": 900 }
  ],
  "rows": [
    {
      "id": "start",
      "label": "/sign-in/new: the email screen",
      "steps": [
        {
          "goto": "/sign-in/new",
          "wait": "h1:has-text('Sign in')",
          "settle": 1500
        }
      ]
    },
    {
      "id": "start-email-error",
      "label": "/sign-in/new: not an email",
      "widths": ["phone-320", "phone"],
      "steps": [
        {
          "goto": "/sign-in/new",
          "wait": "h1:has-text('Sign in')",
          "settle": 1000
        },
        { "fill": "input[type='email']", "text": "not an email" },
        { "clickRole": "button", "name": "^Continue$" },
        { "wait": "[aria-invalid='true']", "settle": 600 }
      ]
    },
    {
      "id": "password",
      "label": "/sign-in/new: the password screen",
      "steps": [
        {
          "goto": "/sign-in/new",
          "wait": "h1:has-text('Sign in')",
          "settle": 1000
        },
        { "fill": "input[type='email']", "text": "fan@example.com" },
        { "clickRole": "button", "name": "^Continue$" },
        { "wait": "h1:has-text('Enter your password')", "settle": 800 }
      ]
    },
    {
      "id": "start-return",
      "label": "/sign-in/new?redirect_url=...: the invite link carries the return path",
      "widths": ["phone"],
      "steps": [
        {
          "goto": "/sign-in/new?redirect_url=%2Fevents%2F42",
          "wait": "h1:has-text('Sign in')",
          "settle": 1000
        }
      ]
    }
  ]
}
