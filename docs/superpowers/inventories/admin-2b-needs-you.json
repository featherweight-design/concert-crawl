{
  "feature": "Admin 2b · Needs you queue",
  "note": "Plan row 2b-A (the queue) and 2b-A2 (the snooze row). CONTACT_SHEET_ROLE=admin. Boards: 02-needs-you/needs-you-desktop, needs-you-mobile, answered-with-undo, snooze-menu, all-clear, couldnt-load; 07/loading-needs-you. By hand: answered-with-undo (it writes), all-clear (needs an empty queue), couldnt-load (API down).",
  "widths": [
    { "label": "phone-320", "width": 320, "height": 740, "touch": true },
    { "label": "phone", "width": 390, "height": 844, "touch": true },
    { "label": "desktop", "width": 1300, "height": 900 }
  ],
  "rows": [
    {
      "id": "queue",
      "label": "/admin/needs-you",
      "steps": [
        {
          "goto": "/admin/needs-you",
          "wait": "[data-testid=\"needs-you-queue\"]",
          "settle": 600
        }
      ]
    },
    {
      "id": "item",
      "label": "First item open",
      "steps": [
        {
          "goto": "/admin/needs-you",
          "wait": "[data-testid=\"needs-you-item\"]"
        },
        { "click": "[data-testid=\"needs-you-item\"]:visible >> nth=0" },
        { "wait": "[data-testid=\"evidence-panel\"]", "settle": 300 }
      ]
    },
    {
      "id": "panel-show-dropped",
      "label": "Show dropped panel (needs a show-dropped item)",
      "steps": [
        {
          "goto": "/admin/needs-you",
          "wait": "[data-item-key^=\"show-dropped:\"]"
        },
        { "click": "[data-item-key^=\"show-dropped:\"]:visible >> nth=0" },
        { "wait": "[data-testid=\"evidence-panel\"]", "settle": 300 }
      ]
    },
    {
      "id": "panel-show-moved",
      "label": "Show moved panel (needs a show-moved item)",
      "steps": [
        {
          "goto": "/admin/needs-you",
          "wait": "[data-item-key^=\"show-moved:\"]"
        },
        { "click": "[data-item-key^=\"show-moved:\"]:visible >> nth=0" },
        { "wait": "[data-testid=\"evidence-panel\"]", "settle": 300 }
      ]
    },
    {
      "id": "panel-venue-failing",
      "label": "Venue failing panel (needs a venue-failing item)",
      "steps": [
        {
          "goto": "/admin/needs-you",
          "wait": "[data-item-key^=\"venue-failing:\"]"
        },
        { "click": "[data-item-key^=\"venue-failing:\"]:visible >> nth=0" },
        { "wait": "[data-testid=\"evidence-panel\"]", "settle": 300 }
      ]
    },
    {
      "id": "panel-venue-blocked",
      "label": "Venue blocked panel (needs a venue-blocked item)",
      "steps": [
        {
          "goto": "/admin/needs-you",
          "wait": "[data-item-key^=\"venue-blocked:\"]"
        },
        { "click": "[data-item-key^=\"venue-blocked:\"]:visible >> nth=0" },
        { "wait": "[data-testid=\"evidence-panel\"]", "settle": 300 }
      ]
    },
    {
      "id": "panel-artist",
      "label": "Artist panel (needs an artist item)",
      "steps": [
        {
          "goto": "/admin/needs-you",
          "wait": "[data-item-key^=\"artist:\"]"
        },
        { "click": "[data-item-key^=\"artist:\"]:visible >> nth=0" },
        { "wait": "[data-testid=\"evidence-panel\"]", "settle": 300 }
      ]
    },
    {
      "id": "panel-event-low-confidence",
      "label": "Low-confidence event panel (needs an event-low-confidence item)",
      "steps": [
        {
          "goto": "/admin/needs-you",
          "wait": "[data-item-key^=\"event-low-confidence:\"]"
        },
        {
          "click": "[data-item-key^=\"event-low-confidence:\"]:visible >> nth=0"
        },
        { "wait": "[data-testid=\"evidence-panel\"]", "settle": 300 }
      ]
    },
    {
      "id": "panel-price-check",
      "label": "Price check panel (needs a price-check item)",
      "steps": [
        {
          "goto": "/admin/needs-you",
          "wait": "[data-item-key^=\"price-check:\"]"
        },
        { "click": "[data-item-key^=\"price-check:\"]:visible >> nth=0" },
        { "wait": "[data-testid=\"evidence-panel\"]", "settle": 300 }
      ]
    },
    {
      "id": "panel-bug",
      "label": "Bug report panel (needs a bug item)",
      "steps": [
        {
          "goto": "/admin/needs-you",
          "wait": "[data-item-key^=\"bug:\"]"
        },
        { "click": "[data-item-key^=\"bug:\"]:visible >> nth=0" },
        { "wait": "[data-testid=\"evidence-panel\"]", "settle": 300 }
      ]
    },
    {
      "id": "snooze",
      "label": "Snooze menu",
      "steps": [
        {
          "goto": "/admin/needs-you",
          "wait": "[data-testid=\"needs-you-item\"]"
        },
        {
          "click": "[data-testid=\"needs-you-item\"]:visible >> nth=0 >> [data-testid=\"snooze-trigger\"]"
        },
        { "wait": "[data-testid=\"snooze-menu\"]" }
      ]
    },
    {
      "id": "venues-filter",
      "label": "Venues filter",
      "steps": [
        {
          "goto": "/admin/needs-you",
          "wait": "[data-testid=\"needs-you-queue\"]"
        },
        { "clickRole": "tab", "name": "^Venues" },
        { "wait": "[data-testid=\"needs-you-queue\"]", "settle": 300 }
      ]
    }
  ]
}
