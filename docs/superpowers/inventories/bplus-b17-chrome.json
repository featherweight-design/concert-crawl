{
  "feature": "B17 · Chrome: header, bottom nav, account menu",
  "note": "Plan row B17 of docs/superpowers/plans/2026-11-11-bplus-redesign.md. Boards (design/design_handoff_bplus_redesign/screens/): shell-browse = 02-mobile/bp-m-browse_m, 01-core/bp-browse; shell-venues = 02-mobile/bp-m-venues_m, 01-core/bp-venues; account = 02-mobile/bp-m-account_m, 01-core/bp-account.",
  "rows": [
    {
      "id": "shell-browse",
      "label": "/events: header and bottom nav",
      "steps": [
        {
          "goto": "/events",
          "wait": "button[aria-label^=\"Account menu\"]:not([aria-label*=\"sign up\"]):visible"
        },
        {
          "wait": "[data-testid=\"event-row\"]"
        }
      ]
    },
    {
      "id": "shell-venues",
      "label": "/venues: the active tab moves",
      "steps": [
        {
          "goto": "/venues",
          "wait": "button[aria-label^=\"Account menu\"]:not([aria-label*=\"sign up\"]):visible"
        },
        {
          "wait": "a[href^=\"/venues/\"]"
        }
      ]
    },
    {
      "id": "account",
      "label": "/events: account menu open",
      "steps": [
        {
          "goto": "/events",
          "wait": "button[aria-label^=\"Account menu\"]:not([aria-label*=\"sign up\"]):visible"
        },
        {
          "wait": "[data-testid=\"event-row\"]"
        },
        {
          "click": "button[aria-label^=\"Account menu\"]:visible",
          "settle": 400,
          "waitDialog": "^Account$"
        }
      ]
    }
  ]
}
