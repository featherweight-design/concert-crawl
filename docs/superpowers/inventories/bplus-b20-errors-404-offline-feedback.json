{
  "feature": "B20 · Errors, 404, offline, feedback tab",
  "note": "Plan row B20 of docs/superpowers/plans/2026-11-11-bplus-redesign.md. Boards (design/design_handoff_bplus_redesign/screens/): not-found = 06-states/bp-s-notfound_m, 06-states/bp-s-notfound_d; offline-page = 06-states/bp-s-offline_m, 06-states/bp-s-offline_empty_m; offline-pill = 06-states/bp-s-offline_pill_m, 06-states/bp-s-offline_account_m; feedback = 06-states/bp-s-feedback_tab_m, 06-states/bp-s-feedback_m. Walk by hand (state a sheet cannot set up): feedback-done (06-states/bp-s-feedback_done_m): sending writes a row.",
  "rows": [
    {
      "id": "offline-page",
      "label": "/~offline: the offline fallback",
      "steps": [
        {
          "goto": "/~offline",
          "wait": "button[aria-label^=\"Account menu\"]:not([aria-label*=\"sign up\"]):visible"
        },
        {
          "wait": "h1:has-text(\"offline\")"
        }
      ]
    },
    {
      "id": "offline-pill",
      "label": "/events offline: the pill",
      "steps": [
        {
          "goto": "/events",
          "wait": "button[aria-label^=\"Account menu\"]:not([aria-label*=\"sign up\"]):visible"
        },
        {
          "wait": "[data-testid=\"event-row\"]"
        },
        {
          "offline": true
        },
        {
          "wait": "[role=\"status\"][aria-label*=\"offline\"]",
          "settle": 300
        }
      ]
    },
    {
      "id": "feedback",
      "label": "/events: the feedback tab opened",
      "steps": [
        {
          "goto": "/events",
          "wait": "button[aria-label^=\"Account menu\"]:not([aria-label*=\"sign up\"]):visible"
        },
        {
          "wait": "[data-testid=\"event-row\"]"
        },
        {
          "click": "button[aria-label=\"Send feedback\"]",
          "settle": 500,
          "waitDialog": "^Feedback$"
        }
      ]
    },
    {
      "id": "not-found",
      "label": "/venues/[slug] unknown: the 404 page",
      "steps": [
        {
          "goto": "/venues/no-such-venue",
          "expectStatus": 404,
          "wait": "button[aria-label^=\"Account menu\"]:not([aria-label*=\"sign up\"]):visible"
        },
        {
          "wait": "[data-testid=\"not-found-surface\"]"
        }
      ]
    }
  ]
}
