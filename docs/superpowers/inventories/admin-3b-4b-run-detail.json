{
  "feature": "Admin 3b PR 4b · Run detail panel",
  "note": "CONTACT_SHEET_ROLE=admin. Boards: 07 a-runs-detail (desktop side panel), phone-addendum gap-2 run-detail-sheet, 04-venues/venue-runs. Read-only: opening a run fetches its pages, nothing is written. Sheet Paused Venue carries lane-seeded mixed runs (seeded runs have no pages).",
  "out": "/Users/huey/Downloads/fwd-handoff/plans/3b-4b-contact-sheet",
  "widths": [
    {
      "label": "320",
      "width": 320,
      "height": 900,
      "touch": true
    },
    {
      "label": "phone",
      "width": 390,
      "height": 900,
      "touch": true
    },
    {
      "label": "640",
      "width": 640,
      "height": 900
    },
    {
      "label": "desktop",
      "width": 1300,
      "height": 1000
    }
  ],
  "rows": [
    {
      "id": "ok-run",
      "label": "OK run open with its pages (Bluebird, newest run)",
      "steps": [
        {
          "goto": "/admin/venues/685205dc-0605-4d9c-b7e8-e71a15f5cea0?tab=runs",
          "wait": "[data-testid=\"run-row\"]"
        },
        {
          "settle": 2500
        },
        {
          "click": "[data-testid=\"run-row\"] >> nth=0"
        },
        {
          "wait": "[data-testid=\"run-detail\"]"
        },
        {
          "settle": 3500
        }
      ]
    },
    {
      "id": "unchanged-run",
      "label": "Unchanged run open: sentence, no pages kept (Sheet Paused Venue)",
      "steps": [
        {
          "goto": "/admin/venues/e4e87c16-2822-402e-a21a-e7b7b070e097?tab=runs",
          "wait": "[data-testid=\"run-row\"]"
        },
        {
          "settle": 2500
        },
        {
          "click": "[data-testid=\"run-row\"] >> nth=0"
        },
        {
          "wait": "[data-testid=\"run-detail\"]"
        },
        {
          "settle": 3000
        }
      ]
    },
    {
      "id": "failed-run",
      "label": "Failed run open (Sheet Paused Venue)",
      "steps": [
        {
          "goto": "/admin/venues/e4e87c16-2822-402e-a21a-e7b7b070e097?tab=runs",
          "wait": "[data-testid=\"run-row\"]"
        },
        {
          "settle": 2500
        },
        {
          "click": "[data-testid=\"run-row\"] >> nth=5"
        },
        {
          "wait": "[data-testid=\"run-detail\"]"
        },
        {
          "settle": 3000
        }
      ]
    },
    {
      "id": "deep-link",
      "label": "Overview Open run lands with the panel open",
      "steps": [
        {
          "goto": "/admin/venues/685205dc-0605-4d9c-b7e8-e71a15f5cea0?tab=overview",
          "wait": "[data-testid=\"venue-overview\"]"
        },
        {
          "clickRole": "link",
          "name": "^Open run$"
        },
        {
          "wait": "[data-testid=\"run-detail\"]"
        },
        {
          "settle": 3000
        }
      ]
    }
  ]
}
