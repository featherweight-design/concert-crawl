{
  "feature": "Admin venue save bars drawn to the boards (Details and Source)",
  "note": "CONTACT_SHEET_ROLE=admin. Boards: addendum-3/04-venues details-d, details-m, phone-addendum gap-4-venue-source source-feed-edited. Read-only: each row fills one field to raise its save bar and no row clicks Save. Save failed is not photographed: Details saves through a server action, so its PATCH runs server-side, out of a browser route mock's reach; PinnedSaveBar and SaveFailedToast tests pin it.",
  "out": "/Users/huey/Downloads/fwd-handoff/plans/b1-save-bar-boards-sheet",
  "widths": [
    {
      "label": "phone",
      "width": 390,
      "height": 900,
      "touch": true
    },
    {
      "label": "desktop",
      "width": 1300,
      "height": 900
    }
  ],
  "rows": [
    {
      "id": "details-bar",
      "label": "Details with an edit: the save bar (Bluebird Theater)",
      "steps": [
        {
          "goto": "/admin/venues/685205dc-0605-4d9c-b7e8-e71a15f5cea0?tab=details",
          "wait": "[data-testid=\"details-venue\"]"
        },
        {
          "settle": 1500
        },
        {
          "fill": "[data-testid=\"details-venue\"] input[id$=\"-neighborhood\"]",
          "text": "Contact sheet edit"
        },
        {
          "wait": "[data-testid=\"details-save-bar\"]"
        },
        {
          "settle": 800
        }
      ]
    },
    {
      "id": "details-bar-bottom",
      "label": "Desktop: Details scrolled to the foot with the bar showing",
      "widths": ["desktop"],
      "steps": [
        {
          "goto": "/admin/venues/685205dc-0605-4d9c-b7e8-e71a15f5cea0?tab=details",
          "wait": "[data-testid=\"details-venue\"]"
        },
        {
          "settle": 1500
        },
        {
          "fill": "[data-testid=\"details-venue\"] input[id$=\"-neighborhood\"]",
          "text": "Contact sheet edit"
        },
        {
          "wait": "[data-testid=\"details-save-bar\"]"
        },
        {
          "settle": 800,
          "scroll": "bottom"
        }
      ]
    },
    {
      "id": "source-bar",
      "label": "Source with an edit: the save bar (Hi-Dive)",
      "steps": [
        {
          "goto": "/admin/venues/99dc4766-0ac5-4dba-89bc-666f70990aa4?tab=source",
          "wait": "[data-testid=\"venue-source\"]"
        },
        {
          "settle": 2500
        },
        {
          "fill": "[data-testid=\"venue-source\"] input[type=\"url\"]",
          "text": "https://hi-dive.example/calendar"
        },
        {
          "wait": "[data-testid=\"source-save-bar\"]"
        },
        {
          "settle": 800
        }
      ]
    }
  ]
}
