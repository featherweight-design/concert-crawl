# Database
# Local: docker-compose Postgres (below).
# Staging/Prod: Neon branch connection string (set in Render dashboard).
DATABASE_URL=postgres://user:password@localhost:5433/concert_crawl_db
# Max connections per process pool. Optional: unset keeps postgres.js's
# default of 10, which is what the long-lived Node server (Render) runs with.
# A serverless host runs many instances, each with its own pool, and sets a
# lower value (3 on Vercel). Anything but a positive integer falls back to 10.
# DB_POOL_MAX=10

# Clerk
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Anthropic (LLM extraction)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret for POST /v1/webhooks/stripe. Printed once by
# `tsx scripts/stripe-provision.ts --mode test --webhooks <url> --commit`,
# or from `stripe listen --print-secret` for local dev.
# Rotation runbook: docs/runbooks/stripe-secrets.md
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (email)
RESEND_API_KEY=re_...

# Admin email — recipient for crawl-failure alerts, event-count-drop alerts,
# and the admin "send test email" pipeline diagnostic.
ADMIN_EMAIL=your-email@example.com

# Used in admin alert email links (defaults to https://concertcrawl.app)
ADMIN_URL=https://concertcrawl.app

# Sentry
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=local

# Logging
LOG_LEVEL=info

# App
NODE_ENV=development
PORT=3001
ALLOWED_ORIGIN=http://localhost:3000

# Internal service key — shared secret for Next.js SSR → API calls that don't carry a
# user token (e.g. landing page hero shows). Must match INTERNAL_API_SECRET in apps/web.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# One-click email unsubscribe HMAC key (#763) — signs the per-family
# unsubscribe links in the weekly Spotify digest. Must match between the API
# service and the spotify-weekly cron. Rotating it invalidates all previously
# issued links. Generate with: openssl rand -hex 32
EMAIL_UNSUBSCRIBE_SECRET=

# Public origin of THIS API service — used to build absolute unsubscribe URLs
# in emails (the route lives on the API, not the web app). Defaults to
# http://localhost:3001 when unset.
API_PUBLIC_URL=http://localhost:3001

# Weekly Spotify job dry run — set to 1 for a log-only cycle: no artist-set
# writes and no digest emails, but eligibility/matching still evaluate and the
# observability row is written. Leave unset for real runs.
SPOTIFY_SYNC_DRY_RUN=

# Generalized weekly digest — set to 1 to send the digest to everyone who
# follows an artist (any source), reading weekly_digest_enabled from
# user_notification_preferences and gating on the `following` entitlement.
# Unset keeps the Spotify-only shape: connections with digest_enabled, gated
# on `spotify-sync`. Default off; flip it once native following is live.
NATIVE_DIGEST_ENABLED=

# Web Push (#971) — VAPID keypair. Generate per environment (staging + prod
# each get their own) via: pnpm tsx scripts/generate-vapid-keys.ts.
# When ANY of the three are unset, the push send pipeline no-ops and
# POST /v1/me/push/subscriptions returns 503 (DELETE/GET/PATCH remain live —
# they don't depend on the keys). Public key is also exposed to the web app
# as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# RFC 8292 `sub` claim for the push-request JWT. Provide either a bare
# email address (e.g. hugh@concertcrawl.app), a full mailto: URI, or an
# https:// URL — send-push.ts (packages/push) prefixes `mailto:` only for
# bare emails and passes any already-scoped value through untouched.
VAPID_SUBJECT=

# Spotify client-credentials app token (#1115) — used ONLY for artist identity
# matching (search + press photo). This is a different grant from the
# user-scoped Spotify OAuth, whose tokens come from Clerk. Create at
# https://developer.spotify.com/dashboard → the Concert Crawl app → Settings;
# the secret is behind "View client secret". When either is unset the matcher
# is dormant: getAppToken() returns null and the match job no-ops.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Scheduled-job triggers (GET /v1/internal/cron/*) for a serverless host's
# scheduler, which sends "Authorization: Bearer $CRON_SECRET". Leave unset on
# Render and locally: the routes then answer 404, and match-artists and
# spotify-weekly run as Render cron services (jobs/*.ts) instead.
# CRON_SECRET=

# Crawler dispatch (Render exit step 2). After an admin queues crawl triggers,
# the API dispatches the crawler-triggers.yml GitHub Actions workflow so the
# crawl starts within a few minutes. CRAWLER_DISPATCH_TOKEN is a fine-grained
# GitHub token with Actions: write on the repo, from a file, never through chat.
# Unset: the API only writes the trigger rows, and the next daily crawl drains
# them. CRAWLER_DISPATCH_REPO overrides the owner/name (default
# HartiganHM/concert-crawl).
# Only a Vercel production or staging deployment (VERCEL_TARGET_ENV)
# dispatches, so setting a token locally does nothing.
# CRAWLER_DISPATCH_TOKEN=
# CRAWLER_DISPATCH_REPO=
