# Database
# Local: docker-compose Postgres (below).
# Staging/Prod: Neon branch connection string (set in Render dashboard).
DATABASE_URL=postgres://user:password@localhost:5433/concert_crawl_db

# Clerk
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Anthropic (LLM extraction)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret for POST /v1/webhooks/stripe. Printed once by
# `tsx scripts/stripe-provision.ts --mode test --webhooks <url> --commit`,
# or from `stripe listen --print-secret` for local dev.
# Rotation runbook: docs/runbooks/stripe-secrets.md
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (email)
RESEND_API_KEY=re_...

# Admin email — recipient for crawl-failure alerts, event-count-drop alerts,
# and the admin "send test email" pipeline diagnostic.
ADMIN_EMAIL=your-email@example.com

# Used in admin alert email links (defaults to https://concertcrawl.app)
ADMIN_URL=https://concertcrawl.app

# Sentry
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=local

# Logging
LOG_LEVEL=info

# App
NODE_ENV=development
PORT=3001
ALLOWED_ORIGIN=http://localhost:3000

# Beta auth gate — set to "true" to require Clerk JWT on public browse/search/venues routes.
# Remove or set to any other value to open these routes at launch.
REQUIRE_BETA_AUTH=true

# Internal service key — shared secret for Next.js SSR → API calls that don't carry a
# user token (e.g. landing page hero shows). Must match INTERNAL_API_SECRET in apps/web.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=
