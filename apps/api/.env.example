# Database
# Local: docker-compose Postgres (below).
# Staging/Prod: Neon branch connection string (set in Render dashboard).
DATABASE_URL=postgres://user:password@localhost:5433/concert_crawl_db

# Clerk
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Anthropic (LLM extraction)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret for POST /v1/webhooks/stripe. Printed once by
# `tsx scripts/stripe-provision.ts --mode test --webhooks <url> --commit`,
# or from `stripe listen --print-secret` for local dev.
# Rotation runbook: docs/runbooks/stripe-secrets.md
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (email)
RESEND_API_KEY=re_...

# Admin email — recipient for crawl-failure alerts, event-count-drop alerts,
# and the admin "send test email" pipeline diagnostic.
ADMIN_EMAIL=your-email@example.com

# Used in admin alert email links (defaults to https://concertcrawl.app)
ADMIN_URL=https://concertcrawl.app

# Sentry
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=local

# PostHog — server-truth monetization funnel analytics (payment_succeeded,
# cancel_completed, founder claims). Both vars optional: when POSTHOG_KEY is
# absent (local dev, CI) capture no-ops and never breaks a billing request.
# Key format: "phc_...". Host defaults to the US cloud region if unset. Set
# both in the Render dashboard for the API service.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Logging
LOG_LEVEL=info

# App
NODE_ENV=development
PORT=3001
ALLOWED_ORIGIN=http://localhost:3000

# Internal service key — shared secret for Next.js SSR → API calls that don't carry a
# user token (e.g. landing page hero shows). Must match INTERNAL_API_SECRET in apps/web.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# One-click email unsubscribe HMAC key (#763) — signs the per-family
# unsubscribe links in the weekly Spotify digest. Must match between the API
# service and the spotify-weekly cron. Rotating it invalidates all previously
# issued links. Generate with: openssl rand -hex 32
EMAIL_UNSUBSCRIBE_SECRET=

# Public origin of THIS API service — used to build absolute unsubscribe URLs
# in emails (the route lives on the API, not the web app). Defaults to
# http://localhost:3001 when unset.
API_PUBLIC_URL=http://localhost:3001

# Weekly Spotify job dry run — set to 1 for a log-only cycle: no artist-set
# writes and no digest emails, but eligibility/matching still evaluate and the
# observability row is written. Leave unset for real runs.
SPOTIFY_SYNC_DRY_RUN=

# Web Push (#971) — VAPID keypair. Generate per environment (staging + prod
# each get their own) via: pnpm tsx scripts/generate-vapid-keys.ts.
# When ANY of the three are unset, the push send pipeline no-ops and
# POST /v1/me/push/subscriptions returns 503 (DELETE/GET/PATCH remain live —
# they don't depend on the keys). Public key is also exposed to the web app
# as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# RFC 8292 `sub` claim for the push-request JWT. Provide either a bare
# email address (e.g. hugh@concertcrawl.app), a full mailto: URI, or an
# https:// URL — send-push.ts (packages/push) prefixes `mailto:` only for
# bare emails and passes any already-scoped value through untouched.
VAPID_SUBJECT=
