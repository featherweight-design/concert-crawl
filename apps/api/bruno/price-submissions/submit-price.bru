meta {
  name: Submit Price
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/events/{{eventId}}/price-submissions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

params:path {
  eventId: 00000000-0000-0000-0000-000000000001
}

body:json {
  {
    "priceMin": 35,
    "priceMax": 75,
    "tier": "GA",
    "vendor": "Ticketmaster",
    "howFound": "bought_myself"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data.id: isDefined
}
