meta {
  name: Get Submission
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/submissions/{{submissionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

params:path {
  submissionId: 00000000-0000-0000-0000-000000000002
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.id: isDefined
}
