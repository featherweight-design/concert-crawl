meta {
  name: Update Submission
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/v1/submissions/{{submissionId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

params:path {
  submissionId: 00000000-0000-0000-0000-000000000002
}

body:json {
  {
    "tier": "Reserved",
    "vendor": "SeatGeek"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
