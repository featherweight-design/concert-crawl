meta {
  name: Update Price Submission (Admin)
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/v1/admin/prices/submissions/{{submissionId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

params:path {
  submissionId: 00000000-0000-0000-0000-000000000002
}

body:json {
  {
    "status": "corroborated"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
