meta {
  name: List Events (Admin)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/admin/events
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

params:query {
  limit: 20
  offset: 0
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data: isDefined
}
