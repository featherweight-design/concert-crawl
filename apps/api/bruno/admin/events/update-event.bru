meta {
  name: Update Event
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/v1/admin/events/{{eventId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

params:path {
  eventId: 00000000-0000-0000-0000-000000000001
}

body:json {
  {
    "status": "cancelled"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
