meta {
  name: Delete Event
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/v1/admin/events/{{eventId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

params:path {
  eventId: 00000000-0000-0000-0000-000000000001
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
