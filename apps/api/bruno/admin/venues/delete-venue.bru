meta {
  name: Delete Venue
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/v1/admin/venues/{{venueId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

params:path {
  venueId: 00000000-0000-0000-0000-000000000003
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
