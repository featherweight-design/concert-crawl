meta {
  name: Create Venue
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/admin/venues
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Bluebird Theater",
    "slug": "bluebird-theater",
    "websiteUrl": "https://bluebirdtheater.net",
    "city": "Denver",
    "crawlDelayMs": 3000
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data.id: isDefined
}
