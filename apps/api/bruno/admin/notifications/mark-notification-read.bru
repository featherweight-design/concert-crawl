meta {
  name: Mark Notification Read
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/v1/admin/notifications/{{notificationId}}/read
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

params:path {
  notificationId: 00000000-0000-0000-0000-000000000007
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
