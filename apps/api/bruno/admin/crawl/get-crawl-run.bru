meta {
  name: Get Crawl Run
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/admin/crawl/runs/{{crawlRunId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.id: isDefined
  res.body.data.venueId: isDefined
  res.body.data.status: isDefined
}
