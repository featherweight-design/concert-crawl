meta {
  name: Get Crawl Trigger
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/admin/crawl/triggers/{{triggerId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

params:path {
  triggerId: 00000000-0000-0000-0000-000000000006
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.id: isDefined
  res.body.data.status: isDefined
}
