meta {
  name: Trigger Crawl
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/admin/crawl/{{venueId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

params:path {
  venueId: 00000000-0000-0000-0000-000000000003
}

assert {
  res.status: eq 202
  res.body.success: eq true
  res.body.data.crawlRunId: isDefined
}
