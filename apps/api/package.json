{
  "name": "@concert-crawl/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "email:preview": "tsx src/emails/preview.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@clerk/backend": "^2.33.6",
    "@concert-crawl/db": "workspace:*",
    "@concert-crawl/entitlements": "workspace:*",
    "@concert-crawl/logger": "workspace:*",
    "@concert-crawl/price-pipeline": "workspace:*",
    "@concert-crawl/push": "workspace:*",
    "@concert-crawl/types": "workspace:*",
    "@hono/clerk-auth": "^2.0.0",
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "^0.9.0",
    "@sentry/hono": "^10.69.0",
    "bad-words": "^4.1.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "posthog-node": "5.47.11",
    "resend": "^6.18.1",
    "stripe": "^22.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@concert-crawl/config": "workspace:*",
    "@concert-crawl/crawler-core": "workspace:*",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.5",
    "postgres": "^3.4.9",
    "tsx": "^4.23.7",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
