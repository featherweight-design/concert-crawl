{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": { "deploymentEnabled": false },
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@concert-crawl/api",
  "regions": ["pdx1"],
  "functions": {
    "api/index.js": { "maxDuration": 300 },
    "api/cron.js": { "maxDuration": 800 }
  },
  "rewrites": [
    { "source": "/v1/internal/cron/:path*", "destination": "/api/cron" },
    { "source": "/:path*", "destination": "/api" }
  ],
  "crons": [
    { "path": "/v1/internal/cron/match-artists", "schedule": "0 16 * * *" },
    { "path": "/v1/internal/cron/spotify-weekly", "schedule": "30 15 * * 1" }
  ]
}
