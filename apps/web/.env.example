# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/events
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/auth/complete

# API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Sentry
SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
SENTRY_ENVIRONMENT=local
SENTRY_AUTH_TOKEN=

# Invite gate
# Generate with: openssl rand -hex 32
INVITE_COOKIE_SECRET=your-secret-here

# App
NODE_ENV=development

# App version shown in user menu status footer.
# Format: "v0.4.2-beta · abc1234" (build label · commit hash)
# Set in Render dashboard under Environment > NEXT_PUBLIC_APP_VERSION
# Defaults to "dev" if unset.
NEXT_PUBLIC_APP_VERSION=
