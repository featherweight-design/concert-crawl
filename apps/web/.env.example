# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/events
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/auth/complete

# API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Sentry
SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
SENTRY_ENVIRONMENT=local
SENTRY_AUTH_TOKEN=

# Invite gate
# Generate with: openssl rand -hex 32
INVITE_COOKIE_SECRET=your-secret-here

# Internal service key — server-side only (never NEXT_PUBLIC_). Sent as x-service-key
# on all API requests so the API can allow Next.js SSR calls without a user token.
# Must match INTERNAL_API_SECRET in apps/api. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# App
NODE_ENV=development

# App version shown in user menu status footer.
# Format: "v0.4.2-beta · abc1234" (build label · commit hash)
# Set in Vercel project settings under Environment Variables > NEXT_PUBLIC_APP_VERSION
# Defaults to "dev" if unset.
NEXT_PUBLIC_APP_VERSION=

# --- Deployment notes ---
# Web is deployed on Vercel (concertcrawl.app). Set the above vars under
# Vercel project settings > Environment Variables. Use different sets for
# Production vs. Preview environments (staging uses Preview).
