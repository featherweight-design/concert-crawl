# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/events
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/auth/complete

# API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Stripe — client-side Stripe.js publishable key; consumed by the payment surface in a later PR
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Sentry
SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
SENTRY_ENVIRONMENT=local
SENTRY_AUTH_TOKEN=

# Invite gate
# Generate with: openssl rand -hex 32
INVITE_COOKIE_SECRET=your-secret-here

# Internal service key — server-side only (never NEXT_PUBLIC_). Sent as x-service-key
# on all API requests so the API can allow Next.js SSR calls without a user token.
# Must match INTERNAL_API_SECRET in apps/api. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# App
NODE_ENV=development

# App version shown in user menu status footer.
# Format: "v0.4.2-beta · abc1234" (build label · commit hash)
# Set in Vercel project settings under Environment Variables > NEXT_PUBLIC_APP_VERSION
# Defaults to "dev" if unset.
NEXT_PUBLIC_APP_VERSION=

# PostHog — client-side monetization funnel analytics. Both vars are optional:
# when NEXT_PUBLIC_POSTHOG_KEY is absent (local dev, previews) analytics no-ops
# and never blocks the UI. Key format: "phc_...". Host defaults to the US cloud
# region if unset. Set both under Vercel project Environment Variables.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Web Push VAPID public key (#971). The private key stays server-side in the
# API service; the public key is exposed here so the browser can subscribe
# with `pushManager.subscribe`. Generate one pair per environment via
# `pnpm tsx scripts/generate-vapid-keys.ts` in the repo root, then paste the
# public value into both this file and the API's VAPID_PUBLIC_KEY. When unset,
# the client falls back to a "not configured" state and never asks for
# notification permission.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Public-launch gate (#794). "true" opens /events, /venues, /search, /watching
# and /onboarding to signed-out visitors and switches the landing page to its
# browse-first CTAs. Anything else — including unset — keeps the private-beta
# invite-code landing page and gates those routes, so a missed config fails
# closed rather than launching the product early. NEXT_PUBLIC_ values are
# inlined at build time, so flipping this in Vercel Production at launch also
# requires a redeploy before it takes effect.
NEXT_PUBLIC_PUBLIC_BROWSE=false

# Absolute origin for crawler-visible URLs (#72). The unfurl metadata on /e/:id
# needs it: a relative og:image is silently ignored by every crawler, and
# generateMetadata runs on the server where there is no window.location to
# resolve one against. Falls back to VERCEL_URL (which Vercel sets on every
# deploy, and which the server can read unprefixed), then to
# http://localhost:3000, so local dev needs no value. Set it in Vercel
# Production to the canonical apex (https://concertcrawl.app) — the fallback
# would otherwise put the per-deployment vercel.app host into shared links.
NEXT_PUBLIC_SITE_URL=

# Proactive ISR revalidation (#847). Shared secret for POST /api/revalidate,
# which the crawler calls after inserting new events so the landing page
# regenerates immediately rather than waiting out its 5-minute ISR window.
# Must match REVALIDATE_SECRET on the Render crawler cron jobs.
# Generate with: openssl rand -hex 32
# When unset the endpoint fails closed (every request gets a 401) and the ISR
# window alone applies.
REVALIDATE_SECRET=

# Shows the Spotify Connect entry point in Settings > Connections. Set to 1
# only while the Spotify app has authenticated-user slots free (Development
# Mode caps at 5). Unset or any other value hides it; existing connections
# stay manageable either way.
NEXT_PUBLIC_SPOTIFY_CONNECT_ENABLED=0

# --- Deployment notes ---
# Web is deployed on Vercel (concertcrawl.app). Set the above vars under
# Vercel project settings > Environment Variables. Use different sets for
# Production vs. Preview environments (staging uses Preview).
