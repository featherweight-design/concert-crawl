# Database
DATABASE_URL=postgres://user:password@localhost:5433/concert_crawl_db

# Anthropic (LLM extraction)
ANTHROPIC_API_KEY=sk-ant-...

# Email alerts (Resend)
RESEND_API_KEY=re_...
ADMIN_EMAIL=your-email@example.com
ADMIN_URL=https://concertcrawl.app

# Sentry
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=local

# Logging
LOG_LEVEL=info

# App
NODE_ENV=development

# Crawl mode: triggers | daily | all (default)
# - triggers: drain the crawl_triggers queue only (run every ~10 min in staging/prod)
# - daily:    run the full venue batch (run once daily at 3 AM MT in staging/prod)
# - all:      run both (default for local dev)
CRAWL_MODE=all
