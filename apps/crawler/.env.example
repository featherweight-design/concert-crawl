# Database
# Local: docker-compose Postgres (below).
# Staging/Prod: Neon branch connection string (set in Render dashboard).
DATABASE_URL=postgres://user:password@localhost:5433/concert_crawl_db

# Anthropic (LLM extraction)
ANTHROPIC_API_KEY=sk-ant-...

# Email alerts (Resend)
RESEND_API_KEY=re_...
ADMIN_EMAIL=your-email@example.com
ADMIN_URL=https://concertcrawl.app

# Sentry
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=local

# Web Push (Spotify new-show fan-out, #763). Same VAPID pair as the API —
# generate once with `npx web-push generate-vapid-keys` and share across
# services. Optional: without them the fan-out still auto-watches but every
# push send returns skipped='not_configured'.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=your-email@example.com

# Clerk (optional). Lets the fan-out derive role-comped plans (admin/team
# accounts) when gating premium pushes; without it derivation is role-less
# and paid plans still resolve from the DB.
CLERK_SECRET_KEY=sk_test_...

# Logging
LOG_LEVEL=info

# App
NODE_ENV=development

# Crawl mode: triggers | daily | all (default)
# - triggers: drain the crawl_triggers queue only (run every ~10 min in staging/prod)
# - daily:    run the full venue batch (run once daily at 3 AM MT in staging/prod)
# - all:      run both (default for local dev)
CRAWL_MODE=all
