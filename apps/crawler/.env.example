# Database
DATABASE_URL=postgres://user:password@localhost:5433/concert_crawl_db

# Anthropic (LLM extraction)
ANTHROPIC_API_KEY=sk-ant-...

# Email alerts (Resend)
RESEND_API_KEY=re_...
ADMIN_EMAIL=your-email@example.com
ADMIN_URL=https://concertcrawl.app

# Sentry
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=local

# Logging
LOG_LEVEL=info

# App
NODE_ENV=development

# Price pipeline — external ticketing APIs
# All optional: tiers are skipped when the key is absent.
TICKETMASTER_API_KEY=
EVENTBRITE_API_TOKEN=
DICE_API_KEY=
SONGKICK_API_KEY=
BANDSINTOWN_APP_ID=
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=
