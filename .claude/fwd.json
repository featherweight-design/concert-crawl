{
  "ownApp": true,
  "uiSweep": "pnpm --filter @concert-crawl/e2e audit:sweep",
  "featureAcceptance": {
    "baseUrl": "http://localhost:3000",
    "productionUrl": [
      "https://concertcrawl.app",
      "https://www.concertcrawl.app",
      "https://api.concertcrawl.app"
    ],
    "widths": [
      {
        "label": "xs",
        "width": 320,
        "height": 640,
        "touch": true
      },
      {
        "label": "phone",
        "width": 390,
        "height": 844,
        "touch": true
      },
      {
        "label": "sm",
        "width": 640,
        "height": 900
      },
      {
        "label": "desktop",
        "width": 1300,
        "height": 900
      }
    ],
    "themes": [
      {
        "label": "electric",
        "dataTheme": "electric",
        "storage": {
          "cc-theme": "electric"
        },
        "colorScheme": "dark"
      },
      {
        "label": "light",
        "dataTheme": "light",
        "storage": {
          "cc-theme": "light"
        },
        "colorScheme": "light"
      },
      {
        "label": "pulse",
        "dataTheme": "pulse",
        "storage": {
          "cc-theme": "pulse"
        },
        "colorScheme": "dark"
      }
    ],
    "pageScope": "",
    "signIn": "apps/e2e/src/fwd/sign-in.mjs",
    "inventories": "docs/superpowers/inventories",
    "out": "contact-sheets",
    "aliases": {
      "@/": "apps/web/src/"
    },
    "packageDir": ["apps/e2e", "apps/web"],
    "tokens": {
      "declare": [
        "apps/web/src/app/globals.css",
        "apps/web/src/theme/themes.ts",
        "apps/web/src/app/layout.tsx"
      ],
      "read": [
        "apps/web/src/components/**/*.{ts,tsx,css}",
        "apps/web/src/app/**/*.{ts,tsx,css}"
      ],
      "hex": ["apps/web/src/components/**/*.{ts,tsx}"],
      "hexFails": false
    },
    "loading": [
      "[aria-busy=\"true\"]",
      ".admin-skeleton",
      ".ap-band-skeleton",
      "[data-testid=\"shelf-skeleton-card\"]",
      "[data-testid=\"me-avatar-skeleton\"]"
    ]
  },
  "orchestrator": {
    "maxLanes": 4,
    "note": "4 per orchestrator while both projects run: 2 Opus + 2 Sonnet (Hugh, 2026-11-11, after the arm64 switch)."
  }
}
