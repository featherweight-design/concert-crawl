{
  "name": "@concert-crawl/types",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sentry": {
      "types": "./dist/sentry-data-collection.d.ts",
      "import": "./dist/sentry-data-collection.js",
      "default": "./dist/sentry-data-collection.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@concert-crawl/config": "workspace:*",
    "@sentry/core": "^11.11.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  }
}
