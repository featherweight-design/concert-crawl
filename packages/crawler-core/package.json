{
  "name": "@concert-crawl/crawler-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./fetchers": {
      "types": "./dist/fetchers.d.ts",
      "import": "./dist/fetchers.js"
    },
    "./triage-conditions": {
      "types": "./dist/lib/triage-conditions.d.ts",
      "import": "./dist/lib/triage-conditions.js"
    },
    "./canonical": {
      "types": "./dist/lib/canonical-artist.d.ts",
      "import": "./dist/lib/canonical-artist.js"
    },
    "./robots": {
      "types": "./dist/lib/robots.d.ts",
      "import": "./dist/lib/robots.js"
    },
    "./robots-fetch": {
      "types": "./dist/lib/robots-fetch.d.ts",
      "import": "./dist/lib/robots-fetch.js"
    },
    "./jitter": {
      "types": "./dist/lib/fetchers/jitter.d.ts",
      "import": "./dist/lib/fetchers/jitter.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@clerk/backend": "^2.33.6",
    "@concert-crawl/db": "workspace:*",
    "@concert-crawl/entitlements": "workspace:*",
    "@concert-crawl/logger": "workspace:*",
    "@concert-crawl/push": "workspace:*",
    "@concert-crawl/types": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "playwright": "^1.64.1",
    "resend": "^6.35.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@concert-crawl/config": "workspace:*",
    "@types/node": "^26.6.6",
    "postgres": "^3.4.9",
    "typescript": "^5.0.0",
    "vitest": "^5.0.5",
    "vite": "^6.0.0"
  }
}
