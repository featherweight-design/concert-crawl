{
  "name": "@concert-crawl/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./scripts/backfill-artists": {
      "import": "./dist/scripts/backfill-artists.js",
      "types": "./dist/scripts/backfill-artists.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "NODE_OPTIONS='--require=tsx/cjs' drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx seed.ts",
    "db:backfill-artists": "tsx src/scripts/run-backfill-artists.ts"
  },
  "dependencies": {
    "@concert-crawl/types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@concert-crawl/config": "workspace:*",
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10",
    "vite": "^6.0.0"
  }
}
