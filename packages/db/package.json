{
  "name": "@concert-crawl/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./upcoming-events": {
      "import": "./dist/lib/upcoming-events.js",
      "types": "./dist/lib/upcoming-events.d.ts"
    },
    "./scripts/backfill-artists": {
      "import": "./dist/scripts/backfill-artists.js",
      "types": "./dist/scripts/backfill-artists.d.ts"
    },
    "./scripts/prune-artists": {
      "import": "./dist/scripts/prune-artists.js",
      "types": "./dist/scripts/prune-artists.d.ts"
    },
    "./scripts/repair-artist-names": {
      "import": "./dist/scripts/repair-artist-names.js",
      "types": "./dist/scripts/repair-artist-names.d.ts"
    },
    "./scripts/musicbrainz-disambiguate": {
      "import": "./dist/scripts/musicbrainz-disambiguate.js",
      "types": "./dist/scripts/musicbrainz-disambiguate.d.ts"
    },
    "./scripts/resolve-photo-tiebreak": {
      "import": "./dist/scripts/resolve-photo-tiebreak.js",
      "types": "./dist/scripts/resolve-photo-tiebreak.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "NODE_OPTIONS='--require=tsx/cjs' drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx seed.ts",
    "db:backfill-artists": "tsx src/scripts/run-backfill-artists.ts",
    "db:prune-artists": "tsx src/scripts/run-prune-artists.ts",
    "db:repair-artist-names": "tsx src/scripts/run-repair-artist-names.ts",
    "db:musicbrainz-disambiguate": "tsx src/scripts/run-musicbrainz-disambiguate.ts",
    "db:resolve-photo-tiebreak": "tsx src/scripts/run-resolve-photo-tiebreak.ts"
  },
  "dependencies": {
    "@concert-crawl/types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@concert-crawl/config": "workspace:*",
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.7",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10",
    "vite": "^6.0.0"
  }
}
