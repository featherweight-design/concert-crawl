{
  "name": "concert-crawl",
  "version": "1.9.1",
  "private": true,
  "scripts": {
    "dev": "pnpm db:migrate && turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate --filter=@concert-crawl/db",
    "db:migrate": "turbo run db:migrate --filter=@concert-crawl/db",
    "db:seed": "turbo run db:seed --filter=@concert-crawl/db",
    "db:sync-local": "docker exec -i concert-crawl-db psql -U postgres -d concert_crawl_db < scripts/staging-snapshot.sql && pnpm db:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "turbo": "2.9.12",
    "prettier": "3.8.3",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "21.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.4",
    "semantic-release": "24.2.9",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.8",
    "@semantic-release/npm": "12.0.2",
    "@semantic-release/release-notes-generator": "14.1.1"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.2",
      "ip-address": "^10.2.0",
      "postcss": "^8.5.14"
    },
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@sentry/cli",
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
