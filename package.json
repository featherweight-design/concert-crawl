{
  "name": "concert-crawl",
  "version": "1.300.0",
  "private": true,
  "scripts": {
    "dev": "pnpm db:migrate && turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate --filter=@concert-crawl/db",
    "db:migrate": "turbo run db:migrate --filter=@concert-crawl/db",
    "db:seed": "turbo run db:seed --filter=@concert-crawl/db",
    "db:sync-local": "docker exec -i concert-crawl-db psql -U postgres -d concert_crawl_db < scripts/staging-snapshot.sql && pnpm db:seed",
    "db:seed:staging": "pnpm db:seed:staging:sync && pnpm db:seed:staging:synthetic",
    "db:seed:staging:sync": "tsx scripts/seed-staging/sync-prod-public-data.ts",
    "db:seed:staging:synthetic": "tsx scripts/seed-staging/seed-synthetic.ts",
    "venues:sync": "tsx scripts/sync-venues.ts",
    "worktree:prune": "scripts/worktree-prune.sh",
    "backlog:status": "scripts/backlog-status.sh",
    "release:draft": "tsx scripts/draft-release.ts",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@clerk/backend": "^2.33.6",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@concert-crawl/crawler-core": "workspace:*",
    "@concert-crawl/db": "workspace:*",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "drizzle-orm": "^0.45.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "postgres": "^3.4.9",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "stripe": "^22.4.0",
    "tsx": "^4.23.7",
    "turbo": "2.10.8",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "fast-uri": "^3.1.2",
      "ip-address": "^10.2.0",
      "js-cookie": "^3.0.7",
      "postcss": "^8.5.14",
      "@semantic-release/github>undici": "^7.28.0",
      "vite": "^6.4.3"
    },
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@sentry/cli",
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^10.0.0"
  }
}
