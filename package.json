{
  "name": "concert-crawl",
  "version": "1.71.3",
  "private": true,
  "scripts": {
    "dev": "pnpm db:migrate && turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate --filter=@concert-crawl/db",
    "db:migrate": "turbo run db:migrate --filter=@concert-crawl/db",
    "db:seed": "turbo run db:seed --filter=@concert-crawl/db",
    "db:sync-local": "docker exec -i concert-crawl-db psql -U postgres -d concert_crawl_db < scripts/staging-snapshot.sql && pnpm db:seed",
    "release:draft": "tsx scripts/draft-release.ts",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@concert-crawl/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "tsx": "^4.22.4",
    "vitest": "^4.1.9",
    "turbo": "2.9.18",
    "prettier": "3.8.4",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "semantic-release": "25.0.5",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.8",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "fast-uri": "^3.1.2",
      "ip-address": "^10.2.0",
      "js-cookie": "^3.0.7",
      "postcss": "^8.5.14",
      "@semantic-release/github>undici": "^7.28.0",
      "vite": "^6.4.3"
    },
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@sentry/cli",
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
